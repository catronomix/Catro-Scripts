# catro-scripts terminal preferences (project-local).
#
# Copy this file to config.ini (same folder, next to the scripts) and uncomment
# what you want. config.ini is gitignored: it is per checkout, not per user.
# A missing, unreadable or malformed config.ini silently falls back to the
# built-in defaults below.
#
# Environment variables win over this file:
#   NO_COLOR, FORCE_COLOR, CATRO_COLOR, CATRO_THEME, CATRO_ASCII
# Precedence: NO_COLOR > FORCE_COLOR > CATRO_* > config.ini > autodetect.

[theme]
# soft | contrast-light | contrast-dark
# soft is the default (cozy purple); contrast-light and contrast-dark are the
# high-contrast pair. Toggle with `theme toggle`; aliases such as cozy, clight
# and hc also work.
#mode = soft

[color]
# auto | none | 16 | 256 | true
# auto means "detect": TERM/COLORTERM, SSH sessions, Windows legacy consoles,
# pipes and dumb terminals all downgrade or go plain automatically.
#level = auto

[table]
# auto | unicode | ascii
# ascii uses + - | instead of box-drawing glyphs (for legacy consoles).
#style = auto
